{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxClean",
  "version": "0.1.0",
  "identifier": "com.voxclean.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VoxClean",
        "width": 900,
        "height": 700,
        "minWidth": 640,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "longDescription": "Record or upload audio. VoxClean transcribes it with Whisper and tidies it with Ollama, all on this computer.",
    "linux": {
      "deb": {
        "depends": ["libasound2t64 | libasound2"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
